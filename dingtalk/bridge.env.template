# cp bridge.env.template ~/bridge/bridge.env && chmod 600 ~/bridge/bridge.env
# 注意：这个文件由 systemd 读取，路径里的 ~ 不会被展开，需要写绝对路径。
SPEAKR_BASE=http://127.0.0.1:8899
# 网页地址，只用来拼「在 Speakr 里打开」的链接
SPEAKR_SITE=https://your-domain.example.com

# read 权限的 Speakr token（网页 Settings → API Tokens，只勾 read）
SPEAKR_TOKEN=__CHANGE_ME__

# dws 可执行文件。不填则用脚本默认值 ~/.local/bin/dws（脚本内部会展开 ~）
#DWS_BIN=/home/you/.local/bin/dws
# 钉钉 userId（单聊发给谁）与目标文件夹 nodeId
DWS_USER_ID=__CHANGE_ME__
DWS_FOLDER_ID=__CHANGE_ME__
# 含空格，必须带引号，否则 . ./bridge.env 会报错
DWS_DOC_PREFIX="IDEA 报告"

POLL_SECONDS=30
LOOKBACK_SECONDS=300
# 去重状态。不填则用脚本默认值 ~/bridge/state/state.json（脚本内部会展开 ~）
#STATE_PATH=/home/you/bridge/state/state.json
