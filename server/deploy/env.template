# 复制到 ~/.config/idea-server/env（chmod 600），不要提交真实值

DATABASE_URL=postgresql://idea:CHANGE_ME@127.0.0.1:5432/idea

# 登录 token 签名密钥，随便一段长随机串
JWT_SECRET=CHANGE_ME

# OpenAI 兼容的 /chat/completions 端点（含 /v1）
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=CHANGE_ME
LLM_MODEL=CHANGE_ME
LLM_MAX_TOKENS=6000
LLM_TIMEOUT_SEC=180

# 同一用户两次入库之间的最小间隔（秒）
SUBMIT_INTERVAL_SEC=10

# 登录 token 有效期（小时）
JWT_TTL_HOURS=24

# 是否暴露 /docs 与 /openapi.json，1 才开；生产保持 0
ENABLE_API_DOCS=0

# 客户端可选的转写服务，JSON 数组
ASR_PRESETS=[{"id":"funasr-lan","name":"局域网 FunASR","url":"http://192.168.5.240:8030","api_key":""}]
