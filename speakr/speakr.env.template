# cp speakr.env.template speakr.env && chmod 600 speakr.env
# 生成 SECRET_KEY：openssl rand -hex 32
SECRET_KEY=__CHANGE_ME__

# ---- 转写：任何 OpenAI 兼容的 /v1/audio/transcriptions ----
# 自己部署的（见 ../asr/）或云厂商的 API 都填这里。
TRANSCRIPTION_BASE_URL=http://127.0.0.1:8030/v1
# 我们的自建服务不鉴权，但这个连接器要求非空，随便填。
TRANSCRIPTION_API_KEY=not-needed
TRANSCRIPTION_MODEL=fun-asr-nano

# ---- 出稿：任何 OpenAI 兼容的 /v1/chat/completions ----
TEXT_MODEL_BASE_URL=http://127.0.0.1:18000/v1
TEXT_MODEL_API_KEY=__CHANGE_ME__
# 实测：同一份中文提示词下 claude-sonnet-5-5 返回 content_filter（0 字），deepseek 正常。
# 换模型前先用一条真录音试，别只看榜单。
TEXT_MODEL_NAME=deepseek-v4.1-flash-1017

# 代码默认 3000，会把长推演从中间截断。
SUMMARY_MAX_TOKENS=8000

# Share 弹窗会无条件先拉 /api/recordings/<id>/shares-internal；
# 默认 false 时该请求 403，前端整个弹窗报 "Failed to load shares: Internal sharing is not enabled"，
# 连公开链接的按钮也点不出来。
ENABLE_INTERNAL_SHARING=true
