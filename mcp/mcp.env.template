# Copy to ~/mcp/mcp.env (chmod 600). No secrets here: callers bring their own Bearer token.
SPEAKR_BASE=http://127.0.0.1:8899
MCP_HOST=127.0.0.1
MCP_PORT=8891
# Host header values nginx may forward; must match exactly or the SDK answers 421.
MCP_ALLOWED_HOSTS=capture.example.com,127.0.0.1:8891
MCP_AUTH_TTL=60
MCP_LOG_LEVEL=warning
